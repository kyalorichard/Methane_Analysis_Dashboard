# Copy to .env. Never commit real secrets.
APP_ENV=production
APP_SECRET_KEY=replace-with-long-random-secret
INTERNAL_API_TOKEN=replace-with-long-random-token
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql+psycopg://methane_app:replace-me@postgres:5432/methane_platform
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=methane-platform
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
# OIDC should be terminated by a trusted identity-aware reverse proxy (e.g. oauth2-proxy).
TRUSTED_AUTH_HEADER=X-Forwarded-User
TRUSTED_EMAIL_HEADER=X-Forwarded-Email
