{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyPlatformBucketPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_PLATFORM_BUCKET",
      "Condition": {
        "StringLike": {"s3:prefix": ["tenants/*"]}
      }
    },
    {
      "Sid": "ReadWriteTenantObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_PLATFORM_BUCKET/tenants/*"
    }
  ]
}
