{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyPlatformSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": [
        "REPLACE_WITH_DATABASE_URL_SECRET_ARN",
        "REPLACE_WITH_INTERNAL_API_TOKEN_SECRET_ARN",
        "REPLACE_WITH_ENTRA_CLIENT_SECRET_ARN",
        "REPLACE_WITH_OAUTH_COOKIE_SECRET_ARN"
      ]
    }
  ]
}
